# Copy to `.env` (gitignored) and fill in only if needed.
#
# Optional outbound proxy for the cloudflared Quick Tunnel container, used when
# Cloudflare (api.trycloudflare.com / edge) is not directly reachable from
# inside Docker. Point at the HOST proxy via host.docker.internal — never
# 127.0.0.1 (that is the container itself). Leave empty for a direct connection.
#
# Example (Clash/Mihomo on the Windows host, HTTP proxy on 7890):
#   CLOUDFLARED_HTTP_PROXY=http://host.docker.internal:7890
#   CLOUDFLARED_HTTPS_PROXY=http://host.docker.internal:7890
CLOUDFLARED_HTTP_PROXY=
CLOUDFLARED_HTTPS_PROXY=

# --- Premarket-news personalisation: semantic embeddings (optional) ----------
# The 勾/叉 preference model is content-based. By default it uses a word/bigram
# classifier. To upgrade to TRUE semantic similarity, point these at any
# OpenAI-compatible /embeddings endpoint. NOTE: DeepSeek has no embeddings API,
# so you must use a different endpoint for this:
#   - OpenAI (cheap):  NEWS_EMBED_BASE_URL=https://api.openai.com/v1
#                      NEWS_EMBED_MODEL=text-embedding-3-small
#                      NEWS_EMBED_API_KEY=sk-...
#   - Local Ollama (free): NEWS_EMBED_BASE_URL=http://host.docker.internal:11434/v1
#                          NEWS_EMBED_MODEL=nomic-embed-text   (run: ollama pull nomic-embed-text)
# Leave empty to keep the word/bigram model.
NEWS_EMBED_BASE_URL=
NEWS_EMBED_MODEL=
NEWS_EMBED_API_KEY=
